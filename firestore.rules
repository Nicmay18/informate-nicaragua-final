rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ========== NOTICIAS ==========
    match /noticias/{noticiaId} {
      // Lectura pública
      allow get, list: if true;

      // Solo administradores pueden crear/editar/eliminar
      // (El acceso está controlado por Firebase Auth + ADMIN_EMAILS en el servidor)
      allow create: if isAdmin()
          && request.resource.data.keys().hasAll(['titulo','contenido','categoria','fecha'])
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() > 0
          && request.resource.data.titulo.size() <= 200
          && request.resource.data.contenido is string
          && request.resource.data.contenido.size() <= 50000;

      allow update: if isAdmin()
          && (!('titulo' in request.resource.data) || (request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 200))
          && (!('contenido' in request.resource.data) || (request.resource.data.contenido is string && request.resource.data.contenido.size() <= 50000));

      allow delete: if isAdmin();
    }

    // ========== NEWSLETTER ==========
    match /newsletter_subscribers/{email} {
      allow read: if isAdmin();
      allow create: if request.resource.data.email == email
          && request.resource.data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
          && request.resource.data.status == 'active'
          && request.resource.data.subscribedAt is timestamp;
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.token.email == email);
    }

    // ========== COMENTARIOS ==========
    match /comentarios/{comentarioId} {
      allow read: if true;
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.contenido is string
          && request.resource.data.contenido.size() > 0
          && request.resource.data.contenido.size() <= 2000
          && request.resource.data.createdAt is timestamp;
      allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
    }

    // ========== ADMIN ONLY ==========
    match /newsletter_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }
    match /newsletter_sponsors/{sponsorId} {
      allow read, write: if isAdmin();
    }
    match /sponsored_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========== VIEWS ==========
    match /views/{slug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count','createdAt','updatedAt'])
          && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count','updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ========== CONFIGURACIÓN ==========
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========== MENI v6.0 COLECCIONES ==========
    // Knowledge Base, Learning Engine, Seguimiento, Portada Intel
    match /kb_entities/{entityId} {
      allow read, write: if isAdmin();
    }
    match /kb_relations/{relationId} {
      allow read, write: if isAdmin();
    }
    match /kb_timelines/{timelineId} {
      allow read, write: if isAdmin();
    }
    match /learning_cycles/{cycleId} {
      allow read, write: if isAdmin();
    }
    match /learning_config/{docId} {
      allow read, write: if isAdmin();
    }
    match /seguimiento_cases/{caseId} {
      allow read, write: if isAdmin();
    }
    match /seguimiento_updates/{updateId} {
      allow read, write: if isAdmin();
    }
    match /portada_intel/{docId} {
      allow read, write: if isAdmin();
    }
    match /portada_intel_config/{docId} {
      allow read, write: if isAdmin();
    }
    match /portada_config/{docId} {
      allow read, write: if isAdmin();
    }
    match /traffic_log/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['slug','titulo','referrer','utmSource','userAgent','source','timestamp','expiresAt'])
          && request.resource.data.slug is string
          && request.resource.data.slug.size() > 0
          && request.resource.data.slug.size() < 300
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() >= 0
          && request.resource.data.titulo.size() < 300
          && request.resource.data.referrer is string
          && request.resource.data.referrer.size() >= 0
          && request.resource.data.referrer.size() < 1000
          && request.resource.data.utmSource is string
          && request.resource.data.utmSource.size() >= 0
          && request.resource.data.utmSource.size() < 300
          && request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() >= 0
          && request.resource.data.userAgent.size() < 1000
          && request.resource.data.source is string
          && request.resource.data.source.size() >= 0
          && request.resource.data.source.size() < 100
          && request.resource.data.timestamp is timestamp
          && request.resource.data.expiresAt is timestamp;
      allow delete: if isAdmin();
    }

    // ========== TRAFFIC DAILY ==========
    match /traffic_daily/{date} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['updatedAt']);
      allow delete: if false;

      match /articles/{slug} {
        allow read: if isAdmin();
        allow create, update: if isAdmin()
            && request.resource.data.keys().hasOnly(['slug','date','views','sources','devices','updatedAt'])
            && request.resource.data.slug is string
            && request.resource.data.date is string
            && request.resource.data.views is number
            && request.resource.data.views >= 0
            && request.resource.data.sources is map
            && request.resource.data.devices is map
            && request.resource.data.updatedAt is string;
        allow delete: if isAdmin();
      }
    }
    match /analytics_traffic/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['event','value','timestamp','path'])
          && request.resource.data.event is string
          && request.resource.data.event.size() > 0
          && request.resource.data.event.size() < 100
          && request.resource.data.value is number
          && request.resource.data.value >= 0
          && request.resource.data.timestamp is timestamp
          && request.resource.data.path is string
          && request.resource.data.path.size() > 0
          && request.resource.data.path.size() < 500;
      allow delete: if false;
    }
    match /distribuciones/{docId} {
      allow read, write: if isAdmin();
    }
    match /distribuciones_pendientes/{docId} {
      allow read, write: if isAdmin();
    }
    match /reportes_crecimiento/{docId} {
      allow read, write: if isAdmin();
    }

    // ========== NIOS / OBSERVABILITY (Fase 3) ==========
    match /nios_telemetry/{docId} {
      allow read, write: if isAdmin();
    }
    match /nios_audit_trail/{docId} {
      allow read, write: if isAdmin();
    }
    match /nios_daily_snapshots/{docId} {
      allow read, write: if isAdmin();
    }
    match /nios_alerts/{docId} {
      allow read, write: if isAdmin();
    }
  }
}

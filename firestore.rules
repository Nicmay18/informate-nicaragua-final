rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== NOTICIAS ==========
    match /noticias/{noticiaId} {
      // Lectura pública
      allow get, list: if true;

      // Solo admins autenticados pueden crear/editar
      allow create: if request.auth != null && request.auth.token.admin == true
          && request.resource.data.keys().hasAll(['titulo','contenido','categoria','fecha'])
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() > 0
          && request.resource.data.titulo.size() <= 200
          && request.resource.data.contenido is string
          && request.resource.data.contenido.size() <= 50000
          && request.resource.data.categoria in ['Sucesos','Nacionales','Deportes','Internacionales','Espectaculos','Tecnologia'];

      allow update: if request.auth != null && request.auth.token.admin == true
          && (!('titulo' in request.resource.data) || (request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 200))
          && (!('contenido' in request.resource.data) || (request.resource.data.contenido is string && request.resource.data.contenido.size() <= 50000))
          && (!('categoria' in request.resource.data) || request.resource.data.categoria in ['Sucesos','Nacionales','Deportes','Internacionales','Espectaculos','Tecnologia']);

      allow delete: if false;
    }

    // ========== NEWSLETTER ==========
    match /newsletter_subscribers/{email} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.resource.data.email == email
          && request.resource.data.email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')
          && request.resource.data.status == 'active'
          && request.resource.data.subscribedAt is timestamp;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // ========== COMENTARIOS ==========
    match /comentarios/{comentarioId} {
      allow read: if true;
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.contenido is string
          && request.resource.data.contenido.size() > 0
          && request.resource.data.contenido.size() <= 2000
          && request.resource.data.createdAt is timestamp;
      allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
    }

    // ========== ADMIN ONLY ==========
    match /newsletter_campaigns/{campaignId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    match /newsletter_sponsors/{sponsorId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    match /sponsored_campaigns/{campaignId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    match /analytics/{docId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // ========== VIEWS ==========
    match /views/{slug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count','createdAt','updatedAt'])
          && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count','updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ========== CONFIGURACIÓN ==========
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

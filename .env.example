# R4 — Variables de entorno requeridas por el código para pruebas runtime NIOS CEO
# Copiar a .env.local, completar y NO commitear.
# Fuente: inspección de lib/nios, app/api/cron, lib/firebase-admin.ts, lib/auth.ts

# Firebase Admin SDK (lib/firebase-admin.ts > getAdminApp())
# Requerido: o FIREBASE_SERVICE_ACCOUNT_BASE64 (>=10 chars) o las 3 siguientes.
# Prueba: Stages 1 Firebase, 2 Traffic, 6 CEO Loop, 7 Memory.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GSC / GA4 / NIOS config (lib/nios/intelligence/orchestrator.ts NIOS_CONFIG; lib/nios/collectors/{gsc,ga4}.ts)
# NIOS_GSC_SITE_URL: prueba Stage 3 GSC (fallback a NIOS_SITE_URL).
# NIOS_GA4_PROPERTY_ID: prueba Stage 4 GA4 (default hardcodeado 525672447, pero se requiere real).
NIOS_SITE_URL=
NIOS_GSC_SITE_URL=
NIOS_GA4_PROPERTY_ID=

# AdSense (lib/nios/intelligence/diagnostics.ts > adSenseDiagnostic())
# Prueba: Stage 5 AdSense.
GOOGLE_ADSENSE_CLIENT_ID=

# Admin / Cron (lib/auth.ts > verifyAdminToken / verifyAdminOrCronToken; app/api/cron/*/route.ts)
# Prueba: Fase 6 CRON auth y Stage 9 Auto Execution autenticación.
ADMIN_API_KEY=
CRON_SECRET=
CRON_SECRET_TOKEN=

# Telegram (app/api/cron/resumen-diario/route.ts > getTelegramConfig)
# Prueba: Fase 6 CRON resumen-diario.
TG_TOKEN=
TG_CHAT_ID=
TG_CHAT=

# Traffic (lib/analytics/traffic-ttl.ts > trafficLogTTLDays())
# Opcionales: Stage 2 Traffic y cron traffic-cleanup.
NIOS_TRAFFIC_LOG_TTL=
NIOS_TRAFFIC_LOG_TTL_DAYS=
